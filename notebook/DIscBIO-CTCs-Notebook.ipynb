   "source": [
    "## Correlation test"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Correlation analysis is a statistical method used to evaluate the strength of relationship between two quantitative variables (genes)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 58,
   "metadata": {},
   "outputs": [],
   "source": [
    "## Creating a dataset, where cells are ordered based on pseudotime ordering\n",
    "FG<-pseudoTimeOrdering(FG,quiet = TRUE, export = FALSE)\n",
    "FG@kordering<-FG@kordering[order(-FG@kordering)]\n",
    "NewNames<-names(FG@kordering)\n",
    "OrderedDataSet<-FG@ndata\n",
    "for (i in 1:length(FG@kordering)){\n",
    "\tOrderedDataSet[1:length(FG@ndata[,1]),i]<-FG@ndata[1:length(FG@ndata[,1]),FG@kordering[i]]\n",
    "}\n",
    "colnames(OrderedDataSet)<-NewNames\n",
    "COL=rainbow(20)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 55,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "\n",
       "\tSpearman's rank correlation rho\n",
       "\n",
       "data:  TGFB1 and KRT18\n",
       "S = 822125956, p-value < 2.2e-16\n",
       "alternative hypothesis: true rho is not equal to 0\n",
       "sample estimates:\n",
       "      rho \n",
       "-0.624741 \n"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "## Spearman correlation between TGFB1 and KRT18\n",
    "KRT18<-as.numeric(OrderedDataSet[\"ENSG00000111057\",])\n",
    "TGFB1<-as.numeric(OrderedDataSet[\"ENSG00000105329\",])\n",
    "cor.test(TGFB1,KRT18, method = \"spearman\",exact=F)"
   ]
  },
